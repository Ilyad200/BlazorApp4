@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-2">@errorMessage</div>
}

@code {
    // 0 расхождений — зелёный (контекст полностью актуален)
    // 1-5 расхождений — жёлтый (контекст частично устарел)
    // 6+ расхождений — красный (контекст сильно разошёлся с тем, что видела нейросеть)
    private string GetStalenessClass(int shift) => shift switch
    {
        0 => "good",
        <= 5 => "warn",
        _ => "bad"
    };

    private string GetStalenessTitle(int shift) => shift switch
    {
        0 => "Контекст актуален: ни одно из предыдущих сообщений не изменилось с момента ответа",
        _ => $"Контекст устарел: {shift} предыд. сообщени{(shift == 1 ? "е" : "й")} изменились с момента ответа"
    };


    [Parameter] public bool IsCompare { get; set; }

    private ChatDb? Chat => IsCompare ? ChatService.CompareWithChat : ChatService.CurrentChatDb;
    private MessageDb? SystemMes => Chat?.Messages.FirstOrDefault(m => m.Order == 0) ?? null;

    private int? hoveredMessageId;

    private bool IsSelectedToCompare(int messageOrder)
    {
        if (IsCompare)
        {
            return ChatService.CompareStartOrderCompare == messageOrder;
        }
        else
        {
            return ChatService.CompareStartOrderMain == messageOrder;
        }
    }
    // private ChatDb? Chat
    // {
    //     get
    //     {
    //         if (ChatId != null) return await ChatService.GetChatById((int)ChatId);
    //         if (ChatService.CurrentChatDbId != null) return ChatService.GetChatById((int)ChatService.CurrentChatDbId);
    //         else return null;
    //     }

    //     set;
    // }
    private ChatDb? CounterpartChat => IsCompare ? ChatService.CurrentChatDb : ChatService.CompareWithChat;
    private bool showDiff = true;

    private bool showSystem = false;

    private MessageDb? GetCounterpartMessage(MessageDb msg)
    {
        if (CounterpartChat == null || !ChatService.IsCompareAligned) return null;

        int myStart = IsCompare ? ChatService.CompareStartOrderCompare!.Value : ChatService.CompareStartOrderMain!.Value;
        int otherStart = IsCompare ? ChatService.CompareStartOrderMain!.Value : ChatService.CompareStartOrderCompare!.Value;

        if (msg.Order < myStart) return null;

        int counterpartOrder = otherStart + (msg.Order - myStart);
        return CounterpartChat.Messages.FirstOrDefault(m => m.Order == counterpartOrder);
    }

    private TextDiffService.DiffResult? GetDiffAgainstCounterpart(MessageDb msg)
    {
        if (!showDiff) return null;
        var counterpart = GetCounterpartMessage(msg);
        if (counterpart == null) return null;
        return TextDiffService.Compare(msg.GetCurrentVersion().Content, counterpart.GetCurrentVersion().Content);
    }

    private MarkupString RenderMessageContent(MessageDb msg, TextDiffService.DiffResult? diff)
    {
        if (diff != null)
        {
            return new MarkupString(TextDiffService.RenderOwnSideHtml(diff));
        }
        var content = msg.GetCurrentVersion().Content ?? "";
        var lines = content.Split('\n');
        var sb = "";
        foreach (var line in lines)
        {
            sb += line + "<br>";
        }
        return new MarkupString(sb);
    }

    // Пороги подобраны так же, как у "светофора" контекста: 85%+ — зелёный,
    // 50-85% — жёлтый, ниже — красный. Это ТЕКСТОВОЕ сходство (по общим словам),
    // не смысловое — перефразированный, но эквивалентный по смыслу ответ может
    // показать низкий процент.
    private string GetSimilarityClass(double similarity) => similarity switch
    {
        >= 0.85 => "similarity-high",
        >= 0.5 => "similarity-medium",
        _ => "similarity-low"
    };

    private string FormatSimilarity(double similarity) => $"{Math.Round(similarity * 100)}%";

    // Среднее сходство по всем сообщениям, у которых нашлась пара в другом чате.
    // Пересчитывается при каждом рендере — для типичных размеров чата это дёшево;
    // если чаты станут очень длинными, имеет смысл закэшировать по (VersionId, VersionId).
    private double? GetAverageSimilarity()
    {
        if (Chat == null || CounterpartChat == null) return null;

        var similarities = new List<double>();
        foreach (var msg in Chat.Messages)
        {
            var counterpart = GetCounterpartMessage(msg);
            if (counterpart == null) continue;
            var diff = TextDiffService.Compare(msg.GetCurrentVersion().Content, counterpart.GetCurrentVersion().Content);
            similarities.Add(diff.Similarity);
        }
        return similarities.Count == 0 ? null : similarities.Average();
    }

    private string userPrompt = "";
    private string errorMessage = "";
    private bool isLoading = false;
    private string? editingMessageId;
    private int? editingMessageDbId;
    private string editContent = "";

    private string selectedModel = "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free";

    private ElementReference scrollElement;

    private bool lastEnabled;

    protected override void OnInitialized()
    {
        ChatService.OnComparisonChanged += OnCompareChanged;
        ChatService.OnChange += StateHasChanged;
        ChatService.OnCompareStart += SetOffset;
        PinService.OnChange += StateHasChanged;

        CompareScrollService.OnChanged += OnCompareScrollChanged;
    }

    public void Dispose()
    {
        ChatService.OnComparisonChanged -= OnCompareChanged;
        ChatService.OnChange -= StateHasChanged;
        ChatService.OnCompareStart -= SetOffset;
        PinService.OnChange -= StateHasChanged;

        CompareScrollService.OnChanged -= OnCompareScrollChanged;
    }
    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync(
                "compareScroll.unregister",
                IsCompare);
    }

    private void OnCompareChanged(bool isCompare)
    {
        StateHasChanged();
    }

    private async void OnCompareScrollChanged(bool enabled)
    {
        lastEnabled = enabled;
    }
    private async void SetOffset()
    {
        await JS.InvokeVoidAsync(
                "compareScroll.setOffset",
                IsCompare ? ChatService.CompareStartOrderCompare - 1
                          : ChatService.CompareStartOrderMain - 1,
                IsCompare);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.BackgroundColor = ConsoleColor.Blue;
            Console.ForegroundColor = ConsoleColor.Magenta;
            Console.WriteLine("[ChatView OnAfterRenderAsync] compareScroll.register");
            Console.WriteLine("[ChatView OnAfterRenderAsync] IsCompare: " + IsCompare.ToString());
            Console.ResetColor();
            // await JS.InvokeVoidAsync(
            //     "compareScroll.register",
            //     !IsCompare,
            //     scrollElement);

            await JS.InvokeVoidAsync(
                "compareScroll.register",
                !IsCompare,
                scrollElement);

            lastEnabled = CompareScrollService.IsEnabled;

        }
    }

    private void StartEdit(MessageDb msg)
    {
        editingMessageDbId = msg.Id;
        editContent = msg.GetCurrentVersion().Content;
        StateHasChanged();
    }

    private async Task SaveEdit(int messageId)
    {
        if (!string.IsNullOrWhiteSpace(editContent))
        {
            await ChatService.UpdateMessageAsync(messageId, editContent, selectedModel, isCompare: IsCompare);
        }
        editingMessageDbId = null;
    }

    private void CancelEdit()
    {
        editingMessageDbId = null;
        StateHasChanged();
    }
    private void PinMessage(MessageDb message)
    {
        var model = message.Versions[message.CurrentVersionOrder].Model;
        PinService.AddMessage(Chat.Id, message, message.Versions[message.CurrentVersionOrder], message.Role, model);
    }

    private async Task AskAIBefor(int lastMessageOrder)
    {
        var lastMessage = Chat!.Messages.FirstOrDefault(m => m.Order == lastMessageOrder);
        if (string.IsNullOrWhiteSpace(lastMessage.GetCurrentVersion().Content)) return;

        errorMessage = "";

        isLoading = true;
        StateHasChanged();

        try
        {
            var apiMessages = Chat!.GetMessagesBefor(lastMessage.Id);
            var response = await AiService.AskAsync(selectedModel, apiMessages);
            Console.ForegroundColor = ConsoleColor.Magenta;
            Console.WriteLine("apiMessages");
            foreach (var m in apiMessages)
            {
                Console.WriteLine(m.Content);
            }


            Console.WriteLine(lastMessage.Order);
            Console.WriteLine(lastMessage.GetCurrentVersion().Content);
            foreach (var m in Chat.Messages.OrderBy(m => m.Order))
            {
                Console.WriteLine(m.GetCurrentVersion().Content);
            }
            Console.ResetColor();

            await ChatService.MakeOriginal(lastMessage.Id, lastMessage.GetCurrentVersion().Id);

            if (Chat.Messages.Count > lastMessage.Order + 1)
            {
                var messages = Chat.Messages.OrderBy(m => m.Order).ToList();
                MessageDb? assistMes = messages[lastMessage.Order + 1];
                Console.ForegroundColor = ConsoleColor.Magenta;
                Console.WriteLine(lastMessage.Order + 1);
                Console.WriteLine(assistMes.GetCurrentVersion().Content);
                Console.ResetColor();
                await ChatService.UpdateMessageAsync(assistMes.Id, response, selectedModel, isOriginal: true, isCompare: IsCompare);
            }
            else
            {
                await ChatService.AddMessageAsync(Chat!.Id, "assistant", response, selectedModel, isOriginal: true);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка при обращении к нейросети: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AskAI()
    {
        if (string.IsNullOrWhiteSpace(userPrompt)) return;

        errorMessage = "";

        if (Chat == null)
        {
            await ChatService.AddChatAsync();
        }
        var previousVersions = await ChatService.GetPreviousVersions(Chat!.Id);
        await ChatService.AddMessageAsync(Chat!.Id, "user", userPrompt.Trim(), selectedModel, isOriginal: true);
        isLoading = true;
        errorMessage = "";
        userPrompt = "";
        StateHasChanged();

        try
        {
            Console.WriteLine("Chat.GetApiMessages");
            var apiMessages = Chat.GetApiMessages();
            Console.WriteLine("AiService.AskAsync");
            var response = await AiService.AskAsync(selectedModel, apiMessages);
            Console.WriteLine("ChatService.AddMessageAsync");
            await ChatService.AddMessageAsync(Chat.Id, "assistant", response, selectedModel, isOriginal: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка при обращении к нейросети: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
    private async Task SwitchVersion(int messageId, bool isNext)
    {
        MessageDb? msg = Chat!.Messages.FirstOrDefault(m => m.Id == messageId);
        if (msg == null)
        {
            Console.ForegroundColor = ConsoleColor.Red;
            Console.WriteLine($"[ChatView SwitchVersion] msg is null (id: {messageId})");
            Console.ResetColor();
            return;
        }
        var targetOrder = isNext ? (msg.CurrentVersionOrder + 1) : (msg.CurrentVersionOrder - 1);
        var newVers = msg!.Versions.FirstOrDefault(v => v.Order == targetOrder);
        if (newVers == null) return;
        await ChatService.SwitchToVersionAsync(Chat.Id, messageId, newVers.Id, isCompare: IsCompare);

        // Console.ForegroundColor = ConsoleColor.Blue;
        // Console.WriteLine("ChatView SetPreviousVersions: start");
        // Console.WriteLine($"ChatView SetPreviousVersions: {messageId}, {versionOrder}");
        StateHasChanged();
    }
    private async Task SetPreviousVersions(int chatId, VersionDb version)
    {
        await ChatService.PreviousVersions(chatId, version);
        StateHasChanged();
    }
    private void SelectComparePoint(MessageDb msg)
    {
        if (!IsCompare)
        {
            ChatService.SetLeftMessageToCompare(msg);
        }
        else
        {
            ChatService.SetRightMessageToCompare(msg);
        }
    }
