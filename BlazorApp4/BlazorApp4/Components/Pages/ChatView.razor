@using BlazorApp4.Services;
@using BlazorApp4.Models;
@using BlazorApp4.Components.Icons;
@using OpenRouter.NET.Models;
@using Markdig

@inject ChatService ChatService
@inject AiService AiService
@inject PinService PinService
@inject CompareScrollService CompareScrollService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="chat-view-root stream @(IsCompare ? 'b' : 'a')">
    @if (Chat != null)
    {
        <div class="system-strip">
            <div class="system-strip-head"
                 @onclick="() => showSystem = !showSystem">
                <span class="sys-chevron">@(showSystem ? "▶" : "▼")</span>
                <span class="sys-label">SYSTEM</span>
                @if (!showSystem)
                {
                    <span class="sys-preview">@SystemMes.GetCurrentVersion().Content</span>
                }
            </div>
            @if (showSystem)
            {
                <div class="system-strip-body">
                    @if (editingMessageDbId == SystemMes.Id)
                    {
                        <div class="sys-edit">
                            <textarea class="sys-textarea" @bind="editContent"
                                      @bind:event="oninput"
                                      @onkeydown="(e) => HandleKeyDownForUpdateMessage(e, SystemMes.Id)"></textarea>
                            <div class="sys-edit-actions">
                                <button class="mini-btn save" @onclick="() => SaveEdit(SystemMes.Id)">Сохранить</button>
                                <button class="mini-btn cancel" @onclick="() => CancelEdit()">Отмена</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="sys-bubble">@(SystemMes.GetCurrentVersion().Content)</div>

                        <div class="msg-foot">
                            @if (SystemMes.Versions.Count > 1)
                            {
                                <div class="ver-reel">
                                    <span class="arrow" @onclick="() => SwitchVersion(SystemMes.Id, false)"
                                          disabled="@(SystemMes.CurrentVersionOrder == 0)">
                                        ◀
                                    </span>
                                    <span class="arrow" @onclick="() => SwitchVersion(SystemMes.Id, true)"
                                          disabled="@(SystemMes.CurrentVersionOrder >= SystemMes.Versions.Count - 1)">
                                        ▶
                                    </span>
                                </div>
                            }
                            <span class="ver-count">в.@(SystemMes.CurrentVersionOrder + 1)/@(SystemMes.Versions.Count)</span>
                            <button class="icon-btn edit-sys" @onclick="() => StartEdit(SystemMes)" title="Редактировать">
                                ✎
                            </button>
                            <button class="icon-btn pin" @onclick="() => PinMessage(SystemMes)" title="Закрепить">
                                📌
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
        <div @ref="scrollElement" id="@(IsCompare ? "compare-chat" : "main-chat")" class="top">
            
            <div  class="stream-scroll">

                @foreach (var msg in Chat.Messages.OrderBy(m => m.Order))
                {
                    @if (msg.Order == 0) continue;
                    <div class="msg @msg.Role 
                            @((IsSelectedToCompare(msg.Order)
                                || (!ChatService.IsCompareAligned && ChatService.IsSelectingCompareStart && hoveredMessageId == msg.Id))
                                ? "compare-marked" : "")
                        @(editingMessageDbId == msg.Id ? "editing" : "")"
                         data-order="@msg.Order"
                        @onmouseover="() => hoveredMessageId = msg.Id"
                        @onmouseout="() => hoveredMessageId = null"
                        @onclick="() => ChatService.SetCompareStart(IsCompare, msg.Order)">
                        @{
                            var contextShift = ChatService.GetContextShift(msg.Id, IsCompare);
                            var diffResult = GetDiffAgainstCounterpart(msg);
                        }
                        <div class="msg-tag">
                            <span class="led @GetStalenessClass(contextShift)"
                            title="@GetStalenessTitle(contextShift)">
                            </span>
                            <span class="model-name">@(msg.Role == "assistant" ? msg.Versions.OrderBy(v => v.Order).First(v => v.Order == msg.GetCurrentVersion().Order).Model : "")</span>

                        </div>
                        @if (editingMessageDbId == msg.Id)
                        {
                            <div class="msg-edit">
                                <textarea class="msg-textarea"
                                          @bind="editContent"
                                          @bind:event="oninput"
                                          @onkeydown="(e) => HandleKeyDownForUpdateMessage(e, msg.Id)"></textarea>
                                <div class="msg-edit-actions">
                                    <button class="mini-btn save" @onclick="() => SaveEdit(msg.Id)">Сохранить</button>
                                    <button class="mini-btn cancel" @onclick="() => CancelEdit()">Отмена</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="msg-row">
                                @if (!ChatService.IsCompareAligned && ChatService.IsSelectingCompareStart && hoveredMessageId == msg.Id && !IsSelectedToCompare(msg.Order))
                                {
                                    <span class="compare-hover-label">⇄ Начать сравнение отсюда</span>
                                }
                                @if (IsSelectedToCompare(msg.Order))
                                {
                                    <span class="compare-start-marker">📍 Начало сравнения</span>
                                }
                                <div class="bubble">
                                    @RenderMarkdown(msg.GetCurrentVersion().Content)
                                </div>
                            </div>
                            <div class="msg-foot">
                                @if (msg.Versions.Count > 1)
                                {
                                    <button class="ver-reel">
                                        <span class="arrow"
                                        @onclick="() => SwitchVersion(msg.Id, false)">
                                            ◀
                                        </span>
                                        <span class="arrow"
                                        @onclick="() => SwitchVersion(msg.Id, true)">
                                            ▶
                                        </span>
                                    </button>
                                    @if (@msg.Versions.Count > 1)
                                    {
                                        <span class="ver-count">@(msg.GetCurrentVersion().Order + 1)/@msg.Versions.Count</span>
                                    }
                                }
                                <button class="icon-btn edit-msg"
                                title="Редактировать"
                                @onclick="() => StartEdit(msg)">
                                    ✎
                                </button>
                                @if (msg.Role == "user")
                                {
                                    <button class="icon-btn resend"
                                    title="Отправить снова"
                                    @onclick="() => AskAIBefor(msg.Order)">
                                        ↻
                                    </button>
                                }
                                else
                                {
                                    <button class="icon-btn resend"
                                    title="Отправить снова"
                                    @onclick="() => AskAIBefor(msg.Order - 1)">
                                        ↻
                                    </button>
                                }
                                <button class="icon-btn pin"
                                title="Редактировать"
                                @onclick="() => PinMessage(msg)">
                                    📌
                                </button>
                                @if (copiedMessageId == msg.Id)
                                {
                                    <div class="icon-btn">
                                        ✓
                                    </div>
                                }
                                else
                                {
                                    <button class="icon-btn copy-content"
                                            title="Копировать содержимое"
                                            @onclick="() => CopyToClipboard(msg.GetCurrentVersion().Content, msg.Id)">
                                        <CopyIcon />
                                    </button>
                                }
                                <div style="position: relative; display: inline-block;">
                                    <button class="icon-btn more-actions" title="Дополнительные действия" @onclick="() => ToggleMenu(msg.Id)">
                                        ⋮
                                    </button>

                                    @if (openMenuMessageId == msg.Id)
                                    {
                                        <div class="menu-overlay" @onclick="() => openMenuMessageId = null"></div>
                                        <div class="popup-menu">
                                            <button class="popup-menu-item" @onclick="() => CreateBranch(msg)">Создать ветку</button>
                                            @if (msg.GetCurrentVersion().IsOriginal)
                                            {
                                                <button class="popup-menu-item"
                                                        @onclick="async () => await SetPreviousVersions(msg.ChatId, msg.GetCurrentVersion())">
                                                    Восстановить контекст
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (diffResult != null)
                                {
                                    <span class="similarity-chip medium">@GetDiffForMes(msg)</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="bottom">
        <div class="input-group">
            <textarea class="input-message" rows="2"
                      @bind="userPrompt"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDownForAskAI"
                      placeholder="Введите сообщение..."></textarea>
            <button class="btn btn-primary" @onclick="() => AskAI()" disabled="@isLoading">
                @(isLoading ? "Думаю..." : "Отправить")
            </button>
        </div>
        <div>
            <ModelSelector @bind-Value="selectedModel" />
        </div>
    </div>
</div>

@code {
    // 0 расхождений — зелёный (контекст полностью актуален)
    // 1-5 расхождений — жёлтый (контекст частично устарел)
    // 6+ расхождений — красный (контекст сильно разошёлся с тем, что видела нейросеть)
    private string GetStalenessClass(int shift) => shift switch
    {
        0 => "good",
        <= 5 => "warn",
        _ => "bad"
    };

    private string GetStalenessTitle(int shift) => shift switch
    {
        0 => "Контекст актуален: ни одно из предыдущих сообщений не изменилось с момента ответа",
        _ => $"Контекст устарел: {shift} предыд. сообщени{(shift == 1 ? "е" : "й")} изменились с момента ответа"
    };


    [Parameter] public bool IsCompare { get; set; }

    private ChatDb? Chat => IsCompare ? ChatService.CompareWithChat : ChatService.CurrentChatDb;
    private MessageDb? SystemMes => Chat?.Messages.FirstOrDefault(m => m.Order == 0) ?? null;

    private int? hoveredMessageId;

    private bool IsSelectedToCompare(int messageOrder)
    {
        if (IsCompare)
        {
            return ChatService.CompareStartOrderCompare == messageOrder;
        }
        else
        {
            return ChatService.CompareStartOrderMain == messageOrder;
        }
    }
    private ChatDb? CounterpartChat => IsCompare ? ChatService.CurrentChatDb : ChatService.CompareWithChat;
    private bool showDiff = true;

    private bool showSystem = false;

    private int? copiedMessageId;

    private MessageDb? GetCounterpartMessage(MessageDb msg)
    {
        if (CounterpartChat == null || !ChatService.IsCompareAligned) return null;

        int myStart = IsCompare ? ChatService.CompareStartOrderCompare!.Value : ChatService.CompareStartOrderMain!.Value;
        int otherStart = IsCompare ? ChatService.CompareStartOrderMain!.Value : ChatService.CompareStartOrderCompare!.Value;

        if (msg.Order < myStart) return null;

        int counterpartOrder = otherStart + (msg.Order - myStart);
        return CounterpartChat.Messages.FirstOrDefault(m => m.Order == counterpartOrder);
    }

    private TextDiffService.DiffResult? GetDiffAgainstCounterpart(MessageDb msg)
    {
        if (!showDiff) return null;
        var counterpart = GetCounterpartMessage(msg);
        if (counterpart == null) return null;
        return TextDiffService.Compare(msg.GetCurrentVersion().Content, counterpart.GetCurrentVersion().Content);
    }

    private string GetDiffForMes(MessageDb mes)
    {
        if (ChatService.CompareStartOrderCompare == null || ChatService.CompareStartOrderMain == null || ChatService.messagesDiffs.Count == 0)
            return "...";
        int targetIndex = mes.Order - 
                    (IsCompare ? (int)ChatService.CompareStartOrderCompare : (int)ChatService.CompareStartOrderMain);

        if (targetIndex >= ChatService.messagesDiffs.Count || targetIndex < 0) return "";
        return (Math.Round(ChatService.messagesDiffs[targetIndex] * 100, 1)).ToString() + "%";
    }

    private string userPrompt = "";
    private bool isLoading = false;
    private int? editingMessageDbId;
    private string editContent = "";

    private string selectedModel = "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free";

    private ElementReference scrollElement;

    private bool lastEnabled;
    
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
          .DisableHtml()
        .Build();

    protected override void OnInitialized()
    {
        ChatService.OnComparisonChanged += OnCompareChanged;
        ChatService.OnChange += StateHasChanged;
        ChatService.OnCompareStart += SetOffset;
        ChatService.OnCompareStart += StateHasChanged;
        ChatService.OnMessagesDiffsChange += StateHasChanged;
        PinService.OnChange += StateHasChanged;

        CompareScrollService.OnChanged += OnCompareScrollChanged;
    }

    public void Dispose()
    {
        ChatService.OnComparisonChanged -= OnCompareChanged;
        ChatService.OnChange -= StateHasChanged;
        ChatService.OnCompareStart -= SetOffset;
        ChatService.OnCompareStart -= StateHasChanged;
        ChatService.OnMessagesDiffsChange -= StateHasChanged;
        PinService.OnChange -= StateHasChanged;

        CompareScrollService.OnChanged -= OnCompareScrollChanged;
    }
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("compareScroll.unregister", IsCompare);
        }
        catch (JSDisconnectedException)
        {
            // Соединение с клиентом уже разорвано (например, пользователь закрыл вкладку).
            // Мы не можем вызвать JS, поэтому просто игнорируем это исключение.
            // Логировать здесь не нужно, это нормальное поведение.
        }
        catch (OperationCanceledException)
        {
            // Иногда при разрыве соединения может вылетать и это исключение.
            // Тоже игнорируем.
        }
    }

    private void OnCompareChanged(bool isCompare)
    {
        StateHasChanged();
    }

    private async void OnCompareScrollChanged(bool enabled)
    {
        lastEnabled = enabled;
    }
    private async void SetOffset()
    {
        await JS.InvokeVoidAsync(
                "compareScroll.setOffset",
                IsCompare ? ChatService.CompareStartOrderCompare - 1
                          : ChatService.CompareStartOrderMain - 1,
                IsCompare);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync(
                "compareScroll.register",
                !IsCompare,
                scrollElement);

            lastEnabled = CompareScrollService.IsEnabled;
        }
    }

    private void StartEdit(MessageDb msg)
    {
        editingMessageDbId = msg.Id;
        editContent = msg.GetCurrentVersion().Content;
        StateHasChanged();
    }

    private async Task SaveEdit(int messageId)
    {
        if (!string.IsNullOrWhiteSpace(editContent))
        {
            await ChatService.UpdateMessageAsync(messageId, editContent, selectedModel, isCompare: IsCompare);
            var msg = Chat?.Messages.FirstOrDefault(m => m.Id == messageId);
            if (msg == null) return;
        }
        editingMessageDbId = null;
    }

    private void CancelEdit()
    {
        editingMessageDbId = null;
        StateHasChanged();
    }
    private void PinMessage(MessageDb message)
    {
        var model = message.Versions[message.CurrentVersionOrder].Model;
        PinService.AddMessage(Chat.Id, message, message.Versions[message.CurrentVersionOrder], message.Role, model);
    }

    private async Task AskAIBefor(int lastMessageOrder)
    {
        var lastMessage = Chat!.Messages.FirstOrDefault(m => m.Order == lastMessageOrder);
        if (string.IsNullOrWhiteSpace(lastMessage.GetCurrentVersion().Content)) return;

        isLoading = true;
        StateHasChanged();

        try
        {
            var apiMessages = Chat!.GetMessagesBefor(lastMessage.Id);
            var response = await AiService.AskAsync(selectedModel, apiMessages);

            await ChatService.MakeOriginal(lastMessage.Id, lastMessage.GetCurrentVersion().Id);

            if (Chat.Messages.Count > lastMessage.Order + 1)
            {
                var messages = Chat.Messages.OrderBy(m => m.Order).ToList();
                MessageDb? assistMes = messages[lastMessage.Order + 1];
                await ChatService.UpdateMessageAsync(assistMes.Id, response, selectedModel, isOriginal: true, isCompare: IsCompare);
            }
            else
            {
                await ChatService.AddMessageAsync(Chat!.Id, "assistant", response, selectedModel, isOriginal: true);
            }
        }
        catch (Exception ex)
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AskAI()
    {
        if (string.IsNullOrWhiteSpace(userPrompt)) return;

        if (Chat == null)
        {
            await ChatService.AddChatAsync();
        }
        var previousVersions = await ChatService.GetPreviousVersions(Chat!.Id);
        await ChatService.AddMessageAsync(Chat!.Id, "user", userPrompt.Trim(), selectedModel, isOriginal: true);
        isLoading = true;
        userPrompt = "";
        StateHasChanged();

        try
        {
            var apiMessages = Chat.GetApiMessages();
            var response = await AiService.AskAsync(selectedModel, apiMessages);
            await ChatService.AddMessageAsync(Chat.Id, "assistant", response, selectedModel, isOriginal: true);
        }
        catch (Exception ex)
        {
        }
        finally
        {
            isLoading = false;
        }
    }
    private async Task SwitchVersion(int messageId, bool isNext)
    {
        MessageDb? msg = Chat!.Messages.FirstOrDefault(m => m.Id == messageId);
        if (msg == null)
        {
            return;
        }
        var targetOrder = isNext ? (msg.CurrentVersionOrder + 1) : (msg.CurrentVersionOrder - 1);
        var newVers = msg!.Versions.FirstOrDefault(v => v.Order == targetOrder);
        if (newVers == null) return;
        await ChatService.SwitchToVersionAsync(Chat.Id, messageId, newVers.Id, isCompare: IsCompare);

        StateHasChanged();
    }
    private async Task SetPreviousVersions(int chatId, VersionDb version)
    {
        await ChatService.PreviousVersions(chatId, version, IsCompare);
        StateHasChanged();
    }

    private async Task HandleKeyDownForAskAI(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await AskAI();
        }
    }

    private async Task HandleKeyDownForUpdateMessage(KeyboardEventArgs e, int messageId)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SaveEdit(messageId);
        }
    }

    private int? openMenuMessageId;

    private void ToggleMenu(int messageId)
    {
        openMenuMessageId = openMenuMessageId == messageId ? null : messageId;
    }

    private async Task CreateBranch(MessageDb msg)
    {
        await ChatService.CreateBranchAsync(Chat.Id, msg.Id);
        openMenuMessageId = null;
    }


    private async Task CopyToClipboard(string content, int messageId)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", content);
            copiedMessageId = messageId;
            StateHasChanged();

            // Возвращаем иконку через 2 секунды
            await Task.Delay(2000);
            copiedMessageId = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            StateHasChanged();
        }
    }

    private MarkupString RenderMarkdown(string content)
    {
        var html = Markdown.ToHtml(content ?? "", MarkdownPipeline);
        return new MarkupString(html);
    }
}