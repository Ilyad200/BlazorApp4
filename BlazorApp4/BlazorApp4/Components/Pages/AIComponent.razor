@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using OpenRouter.NET.Models;
@using BlazorApp4.Services;
@using BlazorApp4.Models;
@inject AiService AiService
@inject ChatService ChatService
@inject PinService PinService
@implements IAsyncDisposable
@inject CompareScrollService CompareScrollService
@inject IJSRuntime JSRuntime

<PageTitle>OpenRouter AI</PageTitle>

<div @ref="elementRef" style="height: 100%">

    <div class="main-container">

    <div class="toolbar">
        <div class="toolbar-title">@ChatService.CurrentChatDb?.Name</div>
        @if (ChatService.CompareWithChat != null)
        {
            <div class="toolbar-sep"></div>
            <div class="compare-pill">
                <span class="swatch a"></span> @ChatService.CurrentChatDb?.Name
                <span style="color:var(--text-faint)">↔</span>
                <span class="swatch b"></span> @ChatService.CompareWithChat?.Name
            </div>
        }
        <button class="btn btn-outline-primary"
                @onclick="()=>Toggle()">

            @(CompareScrollService.IsEnabled
                ? "🔗"
                : "🔓")

        </button>
        <div class="compare-cta" id="compareCta">
            @if (!ChatService.IsCompareAligned && !ChatService.IsSelectingCompareStart && ChatService.CompareWithChat != null)
            {
                <!-- state: idle -->
                <div class="cta-state" data-state="idle">
                    <button class="cta-btn cta-btn-start" id="startCompareBtn"
                            @onclick="() => ChatService.BeginSelectingCompareStart()">
                        ⇄ Начать сравнение
                    </button>
                </div>
            }
            else if (!ChatService.IsCompareAligned && ChatService.IsSelectingCompareStart)
            {
                <!-- state: selecting -->
                <div class="cta-state" data-state="selecting">
                    <button class="cta-btn cta-btn-cancel" id="cancelSelectBtn"
                            @onclick="() => ChatService.CancelSelectingCompareStart()">
                        Отмена
                    </button>
                    <span class="cta-hint-text">Кликните по сообщению в обеих панелях — это будет точка начала сравнения</span>
                </div>
            }
            else if (ChatService.IsCompareAligned)
            {
                <!-- state: aligned -->
                <div class="cta-state" data-state="aligned">
                    <button class="cta-btn cta-btn-reset" id="resetAlignBtn"
                            @onclick="() => ChatService.ResetCompareAlignment()">
                        Сбросить
                    </button>
                    <span class="label">сходство</span>
                    <div class="corr-bar"><i style="width: @(Math.Round(GetAverageSimilarity() * 100))%"></i></div>
                    <span class="corr-val">@(Math.Round(GetAverageSimilarity() * 100))%</span>
                </div>
            }
        </div>
    </div>

        <div class="main-content">

        <SplitView @bind-Sizes="_sizesBetweenChatsAndPin"
            RightVisible="@(PinService.PinnedMessageList.Count != 0)"
            MinLeftSize="500">

            <Left>
                <SplitView @bind-Sizes="_sizesBetweenChats"
                    RightVisible="@(ChatService.CompareWithChat != null)">

                        <Left>
                            @if (ChatService.CurrentChatDb != null)
                            {
                                <ChatView />
                            }
                    </Left>

                    <Right>
                        @if (ChatService.CompareWithChat != null)
                        {
                            <ChatView IsCompare="true" />
                        }
                    </Right>

                </SplitView>
            </Left>

            <Right>
                @if (PinService.PinnedMessageList.Count != 0)
                {
                    <PinnedMessageView />
                }
            </Right>

            </SplitView>
        </div>
    </div>

</div>

@code {
    private bool isSyncEnabled = false;
    private double[] _sizesBetweenChats = [50, 50];
    private double[] _sizesBetweenChatsAndPin = [70, 30];

    private int Width = 50;
    private int Height = 200;
    private DotNetObjectReference<AIComponent>? dotNetRef;
    private ElementReference elementRef;


    protected override void OnInitialized()
    {
        ChatService.OnComparisonChanged += OnCompareChanged;
        ChatService.OnChange += StateHasChanged;
        ChatService.OnMessagesDiffsChange += StateHasChanged;
        PinService.OnChange += OnPinnedMessage;
    }

    public void Dispose()
    {
        ChatService.OnComparisonChanged -= OnCompareChanged;
        ChatService.OnChange -= StateHasChanged;
        ChatService.OnMessagesDiffsChange -= StateHasChanged;
        PinService.OnChange -= OnPinnedMessage;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
        }
        Console.WriteLine($"CompareWithChatId: {(ChatService.CompareWithChatId == null ? "null" : ChatService.CompareWithChatId.ToString())}; AIComponent");
    }

    private void OnCompareChanged(bool isCompare)
    {
        StateHasChanged();
    }

    private void OnPinnedMessage()
    {
        StateHasChanged();
    }

    private void OnSizeChanged((int Width, int Height) newSize)
    {
        Width = newSize.Width;
        Height = newSize.Height;

    }
    private async Task Toggle()
    {
        CompareScrollService.Toggle();
        isSyncEnabled = !isSyncEnabled;

        await JSRuntime.InvokeVoidAsync(
                    "compareScroll.enable",
                    isSyncEnabled);
    }
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (dotNetRef != null)
            {
                dotNetRef.Dispose();
            }
        }
        catch (JSDisconnectedException e)
        {
            dotNetRef?.Dispose();
            Console.WriteLine(e.Message);
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
        }
    }
    private MessageDb? GetCounterpartMessage(MessageDb msg)
    {
        if (ChatService.CompareWithChat == null || !ChatService.IsCompareAligned) return null;

        int currentStart = ChatService.CompareStartOrderMain!.Value;
        int compareStart = ChatService.CompareStartOrderCompare!.Value;

        if (msg.Order < currentStart) return null;

        int counterpartOrder = compareStart + (msg.Order - currentStart);
        return ChatService.CompareWithChat.Messages.FirstOrDefault(m => m.Order == counterpartOrder);
    }
    private double GetAverageSimilarity()
    {
        if (ChatService.messagesDiffs.Count > 0)
        {
            return ChatService.messagesDiffs.Average();
        }
        return 0;
    }
}